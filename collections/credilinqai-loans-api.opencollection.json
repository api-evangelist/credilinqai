{
  "opencollection": "1.0.0",
  "info": {
    "name": "CrediLinq Authentication Loans API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Loans",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Preview Loan",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://sandbox-api.credilinq.ai/v1/loan/calculateloanschedule",
            "headers": [
              {
                "name": "accept-language",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Preview Loan"
        },
        {
          "info": {
            "name": "Create Loan",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://sandbox-api.credilinq.ai/v1/loan",
            "headers": [
              {
                "name": "accept-language",
                "value": ""
              },
              {
                "name": "idempotency-key",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create Loan"
        },
        {
          "info": {
            "name": "Disburse loan",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://sandbox-api.credilinq.ai/v1/loan/disburse",
            "headers": [
              {
                "name": "accept-language",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Disburse loan"
        },
        {
          "info": {
            "name": "Loan Summary",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://sandbox-api.credilinq.ai/v1/loan/summary/:loanId",
            "headers": [
              {
                "name": "accept-language",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "loanId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Loan Summary"
        }
      ]
    }
  ],
  "bundled": true
}