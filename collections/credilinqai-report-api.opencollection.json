{
  "opencollection": "1.0.0",
  "info": {
    "name": "CrediLinq Authentication Report API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Report",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Partner Report",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://sandbox-api.credilinq.ai/v1/reports/partner/partner-report",
            "headers": [
              {
                "name": "accept-language",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get Partner Report"
        },
        {
          "info": {
            "name": "Get Customer Dashboard",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://sandbox-api.credilinq.ai/v1/reports/customer/:customerReferenceNo/dashboard",
            "headers": [
              {
                "name": "accept-language",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "customerReferenceNo",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get Customer Dashboard"
        },
        {
          "info": {
            "name": "Get Credit History",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://sandbox-api.credilinq.ai/v1/reports/credit-history/:customerReferenceNo",
            "headers": [
              {
                "name": "accept-language",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "customerReferenceNo",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get Credit History"
        }
      ]
    }
  ],
  "bundled": true
}