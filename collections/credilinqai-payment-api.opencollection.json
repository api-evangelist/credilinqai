{
  "opencollection": "1.0.0",
  "info": {
    "name": "CrediLinq Authentication Payment API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Payment",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Initiate payment",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://sandbox-api.credilinq.ai/v1/payments/loan/initiate-payment",
            "headers": [
              {
                "name": "accept-language",
                "value": ""
              },
              {
                "name": "idempotency-key",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Initiate payment"
        },
        {
          "info": {
            "name": "Make payment",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://sandbox-api.credilinq.ai/v1/payments/loan/make-payment",
            "headers": [
              {
                "name": "accept-language",
                "value": ""
              },
              {
                "name": "idempotency-key",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Make payment"
        },
        {
          "info": {
            "name": "Reconcile payment",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://sandbox-api.credilinq.ai/v1/payments/loans/reconcilepayment",
            "headers": [
              {
                "name": "accept-language",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Reconcile payment"
        },
        {
          "info": {
            "name": "Payment History",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://sandbox-api.credilinq.ai/v1/payments/loans/payment/:loanId",
            "headers": [
              {
                "name": "accept-language",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "loanId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Payment History"
        }
      ]
    }
  ],
  "bundled": true
}